# AI Project Builder Agent — Environment Configuration
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ── Security ─────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3010

# ── LLM Provider ─────────────────────────────────────
# Options: openai, openrouter, grok
LLM_PROVIDER=openrouter

# OpenRouter (recommended — wide model access)
OPENROUTER_API_KEY=

# Model roles — override to use different models per role
REASONING_PRIMARY_MODEL=
REASONING_SECONDARY_MODEL=
CODING_MODEL=
FAST_MODEL=

# OpenAI (direct)
OPENAI_API_KEY=

# Grok
GROK_API_KEY=

# ── Uploads ──────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── ChromaDB (optional) ──────────────────────────────
CHROMA_ENABLED=false
CHROMA_HOST=localhost
CHROMA_PORT=8000
