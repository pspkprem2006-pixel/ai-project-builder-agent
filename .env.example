# ------------------------------------------------------------------
# AI Project Builder Agent - Environment Configuration
# Copy to .env and adjust values. Never commit .env to version control.
# ------------------------------------------------------------------

# --- Database ------------------------------------------------------
# Use SQLite for local development (no setup required):
#   sqlite:///./data/app.db
# Or PostgreSQL (recommended for production / docker-compose):
#   postgresql+psycopg2://postgres:postgres@localhost:5432/ai_builder
DATABASE_URL=sqlite:///./data/app.db

# --- Security ------------------------------------------------------
# REQUIRED in production: generate a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# The backend refuses to start in production without a strong SECRET_KEY.
SECRET_KEY=<generate-a-long-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Environment ----------------------------------------------------
# Set DEBUG=true for local development. In DEBUG mode a missing/weak
# SECRET_KEY is replaced with a random per-process key (sessions reset on
# restart). NEVER set DEBUG=true in production.
DEBUG=false

# --- SMTP (for "Forgot Password" email). Optional.
# In production, a reset token is NEVER returned through the API, even when
# SMTP is unset or fails. In DEBUG mode only, when SMTP is unavailable, the
# API returns a development reset token so local flows stay testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Project Builder <no-reply@example.com>
APP_PUBLIC_URL=http://localhost:3010

# --- AI / LLM Configuration ---------------------------------------
# Provider-agnostic (any OpenAI-compatible chat completions API).
# Select a preset with LLM_PROVIDER:
#   openai     -> https://api.openai.com/v1 (default model gpt-5.5)
#   grok       -> https://api.x.ai/v1       (xAI Grok, default model grok-4.5)
#   openrouter -> https://openrouter.ai/api/v1 (one key, many models)
# OPENAI_BASE_URL / OPENAI_MODEL always override the preset when set.
#
# Set an API key to enable live AI generation. Without a key the
# application falls back to high-quality template-based blueprints.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120

# --- OpenRouter multi-model routing (current free development option) ----
# LLM_PROVIDER=openrouter routes each agent role to its own model through
# one OpenRouter key. The key is backend-only and never exposed to the
# frontend. Free model availability and rate limits can change at any time;
# the deterministic engine remains the final fallback.
#
# Recommended free defaults (used when *_MODEL is left empty):
#   reasoning_primary   -> nvidia/nemotron-3-ultra-550b-a55b:free
#   reasoning_secondary -> nvidia/nemotron-3-super-120b-a12b:free
#   coding              -> poolside/laguna-s-2.1:free
#   fast                -> nvidia/nemotron-3-nano-30b-a3b:free
#
# *_FALLBACK_MODELS are comma-separated fallback chains tried in order
# after the primary model. All of these variables are optional.
#LLM_PROVIDER=openrouter
#OPENROUTER_API_KEY=
#REASONING_PRIMARY_MODEL=
#REASONING_PRIMARY_FALLBACK_MODELS=
#REASONING_SECONDARY_MODEL=
#REASONING_SECONDARY_FALLBACK_MODELS=
#CODING_MODEL=
#CODING_FALLBACK_MODELS=
#FAST_MODEL=
#FAST_FALLBACK_MODELS=

# --- Optional: ChromaDB memory (project memory & retrieval) --------
# When disabled, an in-process similarity fallback is used.
CHROMA_ENABLED=false
CHROMA_PATH=./data/chroma

# --- CORS ----------------------------------------------------------
# Development defaults are localhost ports. In production (DEBUG=false) the
# backend REFUSES to start unless explicit origins are configured, and "*" is
# never allowed while Bearer-token credentials are in use.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3010,http://localhost:3011

# --- Auth rate limiting --------------------------------------------
# DB-backed fixed-window limits on security-sensitive endpoints. Safe with
# multiple worker processes; no Redis required. 429 responses are identical
# for every identity and never reveal whether an account exists.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_FORGOT=5
RATE_LIMIT_FORGOT_WINDOW=900
RATE_LIMIT_FORGOT_IP=20
RATE_LIMIT_RESET=5
RATE_LIMIT_RESET_WINDOW=900

# --- Request body limit (bytes) ------------------------------------
MAX_REQUEST_BODY_BYTES=2000000

# --- Server port (optional) ----------------------------------------
# Each project can run on its own free port to avoid clashes.
# Default is 8010 locally and 8000 in Docker (see backend/Dockerfile).
# BACKEND_PORT=8021

# --- Frontend (frontend/.env.local) --------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1
